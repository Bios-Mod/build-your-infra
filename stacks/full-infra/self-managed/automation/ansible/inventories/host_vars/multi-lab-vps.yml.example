# Deploy to:   multi-lab-vps host
# Apply:       included automatically by Ansible for host 'multi-lab-vps'
# Module:      stacks/full-infra/self-managed/automation/ansible
# Requires:    none
#
# Host-specific variable definitions for EC2 VPS host (multi-lab-vps).
# Why:         Defines cloud-init default user and peer public keys without hardcoding secrets.
# Doc ref:     context/ansible-implementation.md — Section 4
# Targets:     ec2

---
# Default cloud-init user on Ubuntu Server AWS AMI (used in connection_mode: "pre")
initial_user: "ubuntu"

# WireGuard peer public keys mapped for the EC2 VPS hub
# Note: real keys must never be committed; configure in multi-lab-vps.yml (gitignored)
wireguard_peer_public_keys:
  # Management Mac workstation peer public key
  mac: "REPLACE_WITH_MAC_WIREGUARD_PUBLIC_KEY"
  # Local VM peer public key
  local_vm: "REPLACE_WITH_LOCAL_VM_WIREGUARD_PUBLIC_KEY"
