# Deploy to:   multi-lab-local host
# Apply:       included automatically by Ansible for host 'multi-lab-local'
# Module:      stacks/full-infra/self-managed/automation/ansible
# Requires:    none
#
# Host-specific variable definitions for local VM host (multi-lab-local).
# Why:         Defines installer user, network addressing, SSH keys, and peer public keys without hardcoding secrets.
# Doc ref:     stacks/full-infra/self-managed/automation/self-managed-automation.md
# Targets:     vm

---
# Replace the entire value, including the CHANGE_ME prefix.

# Non-root administrator account hardening restricts SSH to (AllowUsers).
# Can equal vm_initial_user on the local VM.
admin_username: "CHANGE_ME_admin_user"

# Initial username created during Ubuntu Server ISO installation (used for pre-hardening bootstrap)
vm_initial_user: "CHANGE_ME_installer_user"

# Current DHCP / static LAN IP address reachable before network reconfiguration
vm_lan_ip: "192.168.1.CHANGE_ME"

# Primary network interface name identified via 'ip link' (e.g., enp2s0, ens160)
vm_interface: "CHANGE_ME_interface"

# Target static IP and subnet prefix for Netplan (outside router DHCP pool)
vm_static_ip: "192.168.1.CHANGE_ME/24"

# Default gateway router IP
vm_gateway: "192.168.1.1"

# Trusted local LAN CIDR permitted through UFW and whitelisted in Fail2Ban
lan_trusted_cidr: "192.168.1.0/24"

# Dedicated lab SSH key pair (never use personal or GitHub keys)
# Path to the public key installed on target host for dedicated administrator (Step 0)
admin_public_key_file: "~/.ssh/CHANGE_ME_lab_key.pub"

# Connection phase selector:
# 'pre'      -> Initial bootstrap: port 22, initial user (installer on VM, ubuntu on EC2). Default state.
# 'hardened' -> Hardened SSH: port 22222, dedicated admin user over LAN/Elastic IP. Switch in host_vars after Step 3.
# 'wg'       -> WireGuard perimeter: port 22222, dedicated admin user over WireGuard tunnel (172.16.0.3 on VM). Switch in host_vars after Step 5 and tunnel verified.
connection_mode: "pre"

# Private key file used by Ansible control node to connect via SSH
ansible_ssh_private_key_file: "~/.ssh/CHANGE_ME_lab_key"

# WireGuard peer public keys mapped for the local VM
# Note: real keys must never be committed; configure in multi-lab-local.yml (gitignored)
wireguard_peer_public_keys:
  # Management Mac workstation peer public key
  mac: "CHANGE_ME_MAC_WIREGUARD_PUBLIC_KEY"
  # Local VM peer public key
  local_vm: "CHANGE_ME_LOCAL_VM_WIREGUARD_PUBLIC_KEY"

# WireGuard hub (EC2) public key required for client tunnel configuration (Step 5)
wireguard_hub_public_key: "CHANGE_ME_HUB_WIREGUARD_PUBLIC_KEY"

# WireGuard hub endpoint: EC2 public IP (ec2_eip) and port; required; never the VM's own address (e.g. 203.0.113.10:51820; do NOT use internal tunnel IP 172.16.0.1)
wireguard_endpoint: "CHANGE_ME_EC2_PUBLIC_IP:51820"

# Target minimum Lynis Hardening Index threshold for local VM (Step 12)
hardening_lynis_min_score: 88

# Auditd immutable flag (-e 2) from Step 10: disabled during local development to allow
# rule modifications without kernel reboot; switch to true during greenfield rebuild in Block 2C
hardening_auditd_immutable_mode: false

# Dedicated Ed25519 public key file for SFTP user (file-transfer module)
file_transfer_sftp_public_key_file: "~/.ssh/CHANGE_ME_sftp_key.pub"
